{
    "name": "klaasie/scout-solr-engine",
    "description": "An Apache Solr driver for laravel scout",
    "type": "library",
    "keywords": [
        "apache",
        "solr",
        "driver",
        "engine",
        "laravel",
        "scout",
        "search"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Klaas Poortinga",
            "email": "poortinga.k@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "laravel/scout": "^10.0|^11.0",
        "solarium/solarium": "^6.3|^7.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Scout\\Solr\\": "src/",
            "Scout\\Solr\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0",
        "squizlabs/php_codesniffer": "^3.6",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "scripts": {
        "phpcs": " phpcs --standard=phpcs.xml"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Scout\\Solr\\ScoutSolrServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
